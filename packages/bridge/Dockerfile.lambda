# syntax=docker/dockerfile:1

# The SERVERLESS bridge image (the Lambda-path counterpart to the ECS
# Dockerfile).
#
# It runs the SAME workspace code as the ECS bridge but packaged for the AWS
# Lambda container runtime rather than a long-running ECS task:
#
# - linux/arm64 (the Lambda functions run on Graviton, Architecture.ARM_64).
# - Runs the Kiro agent engine (KAS) DIRECTLY, not through kiro-cli. kiro-cli
#   3.x starts its engine only after prctl(PR_SET_PDEATHSIG), which Lambda's
#   sandbox rejects with EPERM, so `kiro-cli acp` cannot run there. Instead the
#   `kiro` stage installs kiro-cli (pinned by the KIRO_CLI_VERSION build ARG,
#   never hardcoded here), runs `kiro-cli acp --agent-engine=v3` once so it
#   unpacks its bundled Node and KAS release into
#   `$HOME/.local/share/kiro-cli/{node,kas/<ver>-<hash>/}`, and copies them to
#   /opt/kiro with a `kas/current` symlink. The runtime stage copies only
#   /opt/kiro (no kiro-cli). The handlers start
#   `/opt/kiro/node --experimental-wasm-modules
#   /opt/kiro/kas/current/node_modules/@kiro/agent/dist/server/acp-server.js
#   --transport=stdio` (KAS_NODE_PATH / KAS_SERVER_PATH in
#   packages/bridge/src/kas-engine.ts; both must match this file).
# - The engine is pinned to the kiro-cli version it came from. Its launch
#   command and env are an INTERNAL, unversioned interface of kiro-cli, so a
#   KIRO_CLI_VERSION bump must re-run the engine smoke before deploy; the
#   build fails loudly here if the unpacked layout changes.
# - esbuild-bundles BOTH Lambda entries at IMAGE-BUILD time into single
#   self-contained CommonJS files (mirroring the ECS image's `bridge.cjs`
#   step), so there is no bare `@nikovirtala/*` import and no raw `.ts` under a
#   node_modules path at runtime (Node refuses to type-strip `.ts` resolved
#   under node_modules):
#     - dist/lambda-consumer.cjs  -> the SQS FIFO cloud consumer `handler`
#       (packages/bridge/src/lambda-consumer.ts), and
#     - dist/caps-publisher.cjs   -> the one-shot CONFIG#CAPS publisher
#       `handler` (packages/bridge/src/caps-publisher.ts).
# - Uses the AWS Lambda Node base image so the handler is invokable by the
#   Lambda runtime. The CDK construct selects WHICH handler each function runs
#   by overriding the image CMD (the `<file>.handler` string), so one image
#   serves both the consumer and the publisher.
# - KIRO_API_KEY is NEVER baked into the image: the functions resolve it at
#   runtime from Secrets Manager via KIRO_API_KEY_SECRET_ARN (resolveKiroApiKey).

# NODE_VERSION pins the Node base image for the deps/bundle stage. It must be a
# REAL, published Docker tag (node:<version>-bookworm-slim). node:26-bookworm-slim
# IS published on Docker Hub (verified, including 26.13.0-bookworm-slim, which
# matches the repo's .mise.toml pin), so the deps stage safely moves to Node 26
# to match the esbuild --target=node26 bundles below and the Node 26 AWS Lambda
# runtime stage (public.ecr.aws/lambda/nodejs:26).
#
# PREVIEW CAVEAT (surfaced loudly on purpose): the RUNTIME stage's AWS Lambda
# base `public.ecr.aws/lambda/nodejs:26` is a PUBLIC PREVIEW image -- AWS lists
# nodejs26.x as public preview (NOT covered by the Lambda SLA/Support, NOT
# recommended for production, GA targeted ~Nov 2026; see the AWS Lambda runtimes
# docs and the CDK gap aws/aws-cdk#39021). This Docker Hub `node:26-bookworm-slim`
# deps tag is GA and unaffected; the preview distinction applies only to the
# Lambda base below. There is NO Docker daemon in CI here, so a Docker host MUST
# confirm `public.ecr.aws/lambda/nodejs:26` resolves before a real
# `-c kiroCliVersion` deploy.
ARG NODE_VERSION=26

############################
# deps: install workspace node_modules with pnpm and bundle both Lambda entries
############################
# CDK passes platform: Platform.LINUX_ARM64 to DockerImageCode.fromImageAsset,
# so buildkit already sets the target platform from the build-level --platform
# flag; a per-FROM --platform would be redundant (RedundantTargetPlatform).
FROM node:${NODE_VERSION}-bookworm-slim AS deps
WORKDIR /app

# Install the pinned pnpm via npm (the node slim image ships npm but not
# corepack, which was unbundled from recent Node distributions).
ARG PNPM_VERSION=12.18.0
RUN npm install -g pnpm@${PNPM_VERSION}

# Copy only the manifests first for better layer caching.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/core/package.json packages/core/package.json
COPY packages/bridge/package.json packages/bridge/package.json
COPY packages/cdk/package.json packages/cdk/package.json

# Install the bridge (and its workspace deps) plus the cdk package, whose dev
# dependency esbuild performs the bundling below. --frozen-lockfile keeps the
# image reproducible; --prod=false pulls in the esbuild devDependency.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    PNPM_HOME=/pnpm pnpm install --frozen-lockfile \
      --filter @nikovirtala/kiro-remote-bridge... \
      --filter @nikovirtala/kiro-remote-cdk --prod=false

# The sources that get bundled (the workspace .ts entries + their imports).
COPY tsconfig.base.json ./tsconfig.base.json
COPY packages/core ./packages/core
COPY packages/bridge ./packages/bridge

# Bundle BOTH Lambda entries to SINGLE self-contained CommonJS files. Settings
# mirror the ECS image's bridge.cjs step: @aws-sdk/* is BUNDLED IN (no
# --external) so the runtime image needs no node_modules at all; `.cjs` forces
# CommonJS (the repo-root package.json is "type": "module"); and
# --resolve-extensions includes `.ts` so esbuild resolves the repo's explicit
# `.ts` import specifiers (allowImportingTsExtensions +
# rewriteRelativeImportExtensions in tsconfig) without a custom plugin. The
# engine child process (/opt/kiro/node) is spawned via child_process, not
# imported, so it is neither bundled nor externalized.
#
# esbuild is a devDependency of @nikovirtala/kiro-remote-cdk; under pnpm's
# isolated node_modules layout its bin is linked ONLY into that package's
# node_modules/.bin, so we invoke it by its explicit path (same as the ECS
# image).
RUN packages/cdk/node_modules/.bin/esbuild packages/bridge/src/lambda-consumer.ts \
      --bundle \
      --platform=node \
      --target=node26 \
      --format=cjs \
      --resolve-extensions=.ts,.js,.mjs,.json \
      --outfile=/app/dist/lambda-consumer.cjs \
    && packages/cdk/node_modules/.bin/esbuild packages/bridge/src/caps-publisher.ts \
      --bundle \
      --platform=node \
      --target=node26 \
      --format=cjs \
      --resolve-extensions=.ts,.js,.mjs,.json \
      --outfile=/app/dist/caps-publisher.cjs

############################
# kiro: install kiro-cli and unpack its bundled engine into /opt/kiro
############################
# Same base as the runtime stage so the unpacked Node binary links against the
# same Amazon Linux 2023 userland it runs on.
FROM public.ecr.aws/lambda/nodejs:26 AS kiro

# The kiro-cli version to install is a REQUIRED build arg (no default pin here).
ARG KIRO_CLI_VERSION
# The official install script URL (overridable for mirrors/air-gapped builds).
# Per the Kiro headless docs the canonical command is
# `curl -fsSL https://cli.kiro.dev/install | bash` (note: no `.sh` suffix).
ARG KIRO_CLI_INSTALL_URL=https://cli.kiro.dev/install

# Install kiro-cli like the ECS image: the official script needs a downloader
# (curl), `unzip`, and `sha256sum`. The AWS Lambda base image is Amazon Linux
# 2023, so packages come from `dnf`/`microdnf`, not apt. The script's shebang is
# `#!/bin/bash` and it uses bash-only features, so it MUST be piped to `bash`.
# The version is passed via `--version` (strict semver). kiro-cli 3.x ships one
# binary; `Q_INSTALL_GLOBAL=1` puts it in /usr/local/bin.
#
# `curl` is NOT in the package list: the Lambda AL2023 base already ships
# `curl-minimal` (which provides /usr/bin/curl), and asking dnf/microdnf for
# the full `curl` package fails with a curl-minimal package conflict.
RUN (command -v microdnf >/dev/null 2>&1 \
      && microdnf install -y bash tar gzip unzip ca-certificates \
      || dnf install -y bash tar gzip unzip ca-certificates) \
    && test -n "${KIRO_CLI_VERSION}" \
    && curl -fsSL "${KIRO_CLI_INSTALL_URL}" | Q_INSTALL_GLOBAL=1 bash -s -- --version "${KIRO_CLI_VERSION}" --no-modify-path \
    && { [ -x /usr/local/bin/kiro-cli ] || { [ -d /root/.local/bin ] && cp -a /root/.local/bin/. /usr/local/bin/; }; } \
    && { [ -x /usr/local/bin/kiro-cli ] || { echo "kiro-cli not found after install" >&2; exit 1; }; } \
    && chmod 0755 /usr/local/bin/kiro-cli \
    && kiro-cli --version

# Unpack the engine. `kiro-cli acp --agent-engine=v3` extracts its embedded Node
# and KAS release under $HOME/.local/share/kiro-cli on first start. Feed it an
# `initialize` and hold stdin open so it gets that far, then let `timeout` end
# it; its exit status does not matter (a dummy key, no network auth), only the
# files it leaves behind. The checks after it fail the build LOUDLY, printing
# the unpack log, if the layout is not exactly one `node` binary plus one
# `kas/<ver>-<hash>/` release. The `*.lock` files kiro-cli leaves next to the
# release are dropped so nothing stale ships.
RUN mkdir -p /build \
    && { (printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":1,"clientCapabilities":{}}}'; sleep 30) \
      | HOME=/build KIRO_API_KEY=dummy timeout 90 kiro-cli acp --agent-engine=v3 >/tmp/unpack.log 2>&1 || true; } \
    && share=/build/.local/share/kiro-cli \
    && { [ -x "${share}/node" ] \
      || { echo "engine unpack failed: ${share}/node missing or not executable" >&2; cat /tmp/unpack.log >&2; exit 1; }; } \
    && set -- "${share}"/kas/*/ \
    && { [ "$#" -eq 1 ] && [ -d "$1" ] \
      || { echo "engine unpack failed: expected exactly one directory in ${share}/kas, got: $*" >&2; cat /tmp/unpack.log >&2; exit 1; }; } \
    && kas_dir="${1%/}" \
    && kas_name="${kas_dir##*/}" \
    && mkdir -p /opt/kiro/kas \
    && cp -L "${share}/node" /opt/kiro/node \
    && cp -a "${kas_dir}" "/opt/kiro/kas/${kas_name}" \
    && ln -s "${kas_name}" /opt/kiro/kas/current \
    && rm -f /opt/kiro/kas/*.lock \
    && chmod -R a+rX /opt/kiro \
    && { test -f /opt/kiro/kas/current/node_modules/@kiro/agent/dist/server/acp-server.js \
      || { echo "engine unpack failed: acp-server.js missing under /opt/kiro/kas/current" >&2; cat /tmp/unpack.log >&2; exit 1; }; } \
    && /opt/kiro/node --version \
    && echo "engine unpacked: kas/${kas_name}"

############################
# runtime: AWS Lambda Node base + the unpacked engine + the bundles
############################
# The AWS Lambda base image ships the Runtime Interface Client/Emulator so the
# bundled `handler` export is invokable by the Lambda service. public.ecr.aws
# is the canonical source for the managed base images.
FROM public.ecr.aws/lambda/nodejs:26 AS runtime

# Only the engine (its Node binary and the KAS release); kiro-cli itself is not
# needed at runtime.
COPY --from=kiro /opt/kiro /opt/kiro

# The engine needs a WRITABLE HOME/KIRO_HOME for its config/sessions/agent
# state. The Lambda execution environment only guarantees /tmp is writable, so
# point HOME and KIRO_HOME under /tmp (the handlers never persist anything that
# must survive an invocation -- durable state lives in DynamoDB/S3).
ENV HOME=/tmp \
    KIRO_HOME=/tmp/.kiro

# Both self-contained bundles are the only app artifacts needed at runtime:
# each inlines the @nikovirtala/* workspace code AND @aws-sdk/*, so there is no
# node_modules and no raw .ts source in the runtime image. They land under the
# Lambda task root so the CMD can address them as `<file>.handler`.
COPY --from=deps /app/dist/lambda-consumer.cjs ${LAMBDA_TASK_ROOT}/lambda-consumer.cjs
COPY --from=deps /app/dist/caps-publisher.cjs ${LAMBDA_TASK_ROOT}/caps-publisher.cjs

# Default to the SQS consumer handler. The CDK construct overrides this CMD for
# the caps-publisher function (to `caps-publisher.handler`) so one image serves
# both functions. The AWS Lambda base image's ENTRYPOINT is the Runtime
# Interface Client, which invokes the handler named by this CMD.
CMD ["lambda-consumer.handler"]
