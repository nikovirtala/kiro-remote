{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "v": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "string",
      "minLength": 1
    },
    "effect": {
      "type": "string",
      "const": "annotation"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "pr": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^/\\s]+\\/[^#\\s]+#[1-9][0-9]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "string",
      "enum": ["mcp", "rest", "trailer", "webhook", "harvest", "sweep", "bridge"]
    },
    "type": {
      "type": "string",
      "const": "prompt.failed"
    },
    "payload": {
      "type": "object",
      "properties": {
        "turnId": {
          "type": "string",
          "minLength": 1
        },
        "whenBusy": {
          "type": "string",
          "const": "queue"
        },
        "reason": {
          "type": "string",
          "enum": ["session_deleted", "session_failed", "not_sent"]
        }
      },
      "required": ["turnId", "whenBusy", "reason"],
      "additionalProperties": false
    }
  },
  "required": ["v", "id", "seq", "ts", "effect", "sessionId", "pr", "source", "type", "payload"],
  "additionalProperties": false
}
