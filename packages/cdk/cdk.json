{
  "app": "node bin/app.ts",
  "watch": {
    "include": ["bin/**", "src/**"],
    "exclude": ["node_modules", "cdk.out"]
  },
  "context": {
    "publicBaseUrl": "https://kiro-remote.nikovirtala.dev",
    "cognitoDomainPrefix": "kiro-remote",
    "allowedRepos": "*/*",
    "customDomainName": "kiro-remote.nikovirtala.dev",
    "dnsZoneName": "kiro-remote.nikovirtala.dev",
    "hostedZoneId": "Z00492973OD5EM79JPSQP",
    "kiroCliVersion": "2.31.0",
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/core:newStyleStackSynthesis": true,
    "@aws-cdk/aws-apigateway:disableCloudWatchRole": true,
    "@aws-cdk/core:target-partitions": ["aws", "aws-cn"]
  }
}
