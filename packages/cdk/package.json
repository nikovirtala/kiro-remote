{
  "name": "@nikovirtala/kiro-remote-cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kiro-remote-cdk": "./bin/app.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cdk": "./src/index.ts"
  },
