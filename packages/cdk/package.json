    "@nikovirtala/kiro-remote-core": "workspace:*",
    "@nikovirtala/kiro-remote-mcp": "workspace:*",
    "aws-cdk-lib": "^2.275.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.1148.0",
    "esbuild": "^0.25.0"
  }
}
