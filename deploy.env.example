# kiro-remote deploy config. Copy to `deploy.env` and fill it in:
#
#   cp deploy.env.example deploy.env
#   $EDITOR deploy.env
#   ./scripts/deploy.sh --dry-run    # verify profile, account, region, flags
#   ./scripts/deploy.sh
#
# `deploy.env` is gitignored. It holds no secrets (the Kiro API key stays in
# Secrets Manager), only account-specific ids. Values are plain KEY=value lines;
# scripts/deploy.sh maps each one to the matching CDK `-c camelCase=value` flag.
# A blank optional key is omitted from the cdk command entirely.

# --- AWS account / profile / region -----------------------------------------
# Named AWS profile for every aws/cdk call. Precedence (highest first):
# --profile flag > this key > an exported AWS_PROFILE/AWS_DEFAULT_PROFILE.
AWS_PROFILE=
# The account the profile must resolve to (checked with sts get-caller-identity).
AWS_ACCOUNT_ID=827333031966
# The region every aws/cdk call is pinned to. The profile's default region is
# never used.
AWS_REGION=eu-north-1

# --- Required ---------------------------------------------------------------
# kiro-cli version baked into the Lambda bridge image (-c kiroCliVersion). Also
# the trigger for building the real Lambda bridge image and API Lambda bundle.
KIRO_CLI_VERSION=3.1.0
# Full ARN of the pre-existing Secrets Manager secret holding the ksk_ key
# (-c kiroApiKeySecretArn). Must be in AWS_REGION / AWS_ACCOUNT_ID.
KIRO_API_KEY_SECRET_ARN=

# --- Stack shape (defaults shown) -------------------------------------------
PUBLIC_BASE_URL=https://kiro-remote.nikovirtala.dev
COGNITO_DOMAIN_PREFIX=kiro-remote
# Comma-separated owner/name globs, no spaces.
ALLOWED_REPOS=*/*

# --- Custom domain + Route 53 -----------------------------------------------
# Set CUSTOM_DOMAIN_NAME or DNS_ZONE_NAME to an empty value to turn that part off.
CUSTOM_DOMAIN_NAME=kiro-remote.nikovirtala.dev
# Synthesizes KiroRemoteDnsStack (the Route 53 hosted zone) when set.
DNS_ZONE_NAME=kiro-remote.nikovirtala.dev
# HostedZoneId output of KiroRemoteDnsStack. Required when DNS_ZONE_NAME is set.
HOSTED_ZONE_ID=
# Optional: zone name if it differs from DNS_ZONE_NAME.
HOSTED_ZONE_NAME=
# Optional: import an existing ACM cert instead of creating one.
CERTIFICATE_ARN=
